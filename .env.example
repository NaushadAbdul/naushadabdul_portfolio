# ------------------------------------------------------------
#  Copy this file to `.env.local` and fill in the values.
#  Without these the site still runs, using the fallback
#  content in `lib/content.ts`.
# ------------------------------------------------------------

# Supabase — dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects get a publishable key (sb_publishable_…);
# older ones have an anon key. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
#  OPTIONAL — server-only. Never prefix this with NEXT_PUBLIC_.
#
#  Only needed for one thing: creating a brand-new auth account from
#  /admin/admins. Everything else (granting admin to an existing
#  account, all content editing) works without it.
#
#  This key bypasses Row Level Security entirely. It stays on the
#  server; if it ever reaches the browser, the project is wide open.
#  Rotate it in the dashboard if that happens.
# ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered (your inbox).
CONTACT_EMAIL=

# Optional. Must be a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# Defaults to Resend's shared onboarding address, which only delivers to
# the address your Resend account was created with.
CONTACT_FROM_EMAIL=
